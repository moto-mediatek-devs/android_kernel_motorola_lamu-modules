/*[TN.NJDC] fingerprint overlay file.start*/
&spi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	fpc@0 {
		compatible = "mediatek,fingerprint";
		reg = <0>;
		spi-max-frequency = <1000000>;
		status = "okay";
	};
};

&pio {
    fpc_fpsensor_spi_default: state_fpsensor_spi_default {
    };

    fpc_fpsensor_fpc_rst_low: state_fpsensor_fpc_rst_low {
        pins_cmd_dat {
            pinmux = <PINMUX_GPIO112__FUNC_GPIO112>;
            slew-rate = <1>;
            output-low;
        };
    };

    fpc_fpsensor_fpc_rst_high: state_fpsensor_fpc_rst_high {
        pins_cmd_dat {
            pinmux = <PINMUX_GPIO112__FUNC_GPIO112>;
            slew-rate = <1>;
            output-high;
        };
    };

	fpc_fp_pins_spi: state_spi_mode {
		pins_cmd_dat {
			pinmux = <PINMUX_GPIO33__FUNC_SPI0_CSB>,
					<PINMUX_GPIO35__FUNC_SPI0_CLK>,
					<PINMUX_GPIO32__FUNC_SPI0_MI>,
					<PINMUX_GPIO34__FUNC_SPI0_MO>;
			drive-strength = <4>;
		};
	};
};

&fingerprint_fpc {
	pinctrl-names = "fpsensor_spi_default", "fpsensor_fpc_rst_low", "fpsensor_fpc_rst_high";
	pinctrl-0 = <&fpc_fpsensor_spi_default>;
	pinctrl-1 = <&fpc_fpsensor_fpc_rst_low>;
	pinctrl-2 = <&fpc_fpsensor_fpc_rst_high>;
	pinctrl-5 = <&fpc_fp_pins_spi>;
	
	fpc,enable-wakeup;
	interrupt-parent = <&pio>;
	interrupts = <8 0x2008>;
	debounce = <8 0>;
	fpc,rst_gpio = <&pio 112 0x0>;
	fpc,irq_gpio = <&pio 8 0>;
	status = "okay";
};
/*[TN.NJDC] fingerprint overlay file.end*/
