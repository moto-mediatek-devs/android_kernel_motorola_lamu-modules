/*[TN.NJDC] charger overlay file.start*/
#include <dt-bindings/iio/mt635x-auxadc.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/pinctrl/mt6768-pinfunc.h>

&lk_charger {
	/* charging current */
	usb_charger_current = <500000>;
	ac_charger_current = <2000000>;
	ac_charger_input_current = <1800000>;
	charging_host_charger_current = <1500000>;
	ta_ac_charger_current = <1500000>;
	pd_charger_current = <1500000>;
	max_charger_voltage = <9500000>;
	led_brightness = <102>;
};

&charger {
	battery_cv = <4500000>;
	max_charger_voltage = <11000000>;
	min_charger_voltage = <4700000>;
	hvdcp_input_current_limit = <3000000>;
	hvdcp_charging_current_limit = <3600000>;
	pdc_input_current_limit = <3000000>;
	pdc_charging_current_limit = <3600000>;
	/* battery temperature protection */
	enable_min_charge_temp;
	min_charge_temp = <(-20)>;
	min_charge_temp_plus_x_degree = <(-17)>;
	max_charge_temp = <60>;
	max_charge_temp_minus_x_degree = <57>;
	/* charging current */
	usb_charger_current = <500000>;
	ac_charger_current = <2400000>;
	ac_charger_input_current = <2200000>;
	charging_host_charger_current = <1500000>;
	/* sw jeita */
	enable_sw_jeita;
	jeita_temp_above_t4_cv = <4200000>;
	jeita_temp_t3_to_t4_cv = <4200000>;
	jeita_temp_t2_to_t3_cv = <4500000>;
	jeita_temp_t1_to_t2_cv = <4500000>;
	jeita_temp_t0_to_t1_cv = <4200000>;
	jeita_temp_below_t0_cv = <4040000>;
	jeita_temp_above_t4_icurrent = <0>;
	jeita_temp_t3_to_t4_icurrent = <2550000>;
	jeita_temp_t2_to_t3_icurrent = <3600000>;
	jeita_temp_t1_to_t2_icurrent = <2550000>;
	jeita_temp_t0_to_t1_icurrent = <1000000>;
	jeita_temp_below_t0_icurrent = <0>;
	temp_t4_thres = <60>;
	temp_t4_thres_minus_x_degree = <57>;
	temp_t3_thres = <45>;
	temp_t3_thres_minus_x_degree = <42>;
	temp_t2_thres = <15>;
	temp_t2_thres_plus_x_degree = <18>;
	temp_t1_thres = <0>;
	temp_t1_thres_plus_x_degree = <3>;
	temp_t0_thres = <(-20)>;
	temp_t0_thres_plus_x_degree = <(-17)>;
	temp_neg_10_thres = <(-22)>;
/* TN Begin modified by xinjun.lu/860715 20240814 CR/EKLAMU-202 */
	eoc_current = <200000>;
	/*pe50 config*/
	pe50,iterm-ma = <300>;
	pe50,pe50-temp-zones = <0 4208 1000 1000>,
			<10 4250 2900 1750>,
			<10 4500 1750 1750>,
			<15 4500 2900 2900>,
			<45 4320 6000 5200>,
			<45 4450 5200 4000>,
			<45 4530 4000 4000>,
			<60 4208 2900 0>;
	pe50,pe50-ffc-zones = <0 4208 300>,
			<15 4496 300>,
			<25 4528 738>,
			<35 4528 907>,
			<45 4528 1500>,
			<60 4208 300>;
/* TN End modified by xinjun.lu/860715 20240905 CR/EKLAMU-202 */
	/* ffc bat cfg */
	ffc-batt-zone = <0 4208 300>,
			<15 4496 300>,
			<25 4528 738>,
			<35 4528 907>,
			<45 4528 1500>,
			<60 4208 300>;
};

/* TN Begin modified by xinjun.lu/860715 20240905 CR/EKLAMU-202 */
&pe5 {
	polling-interval = <500>;
	vbat-cv = <4530>;
	start-soc-min = <0>;
	start-soc-max = <90>;
	stop-soc-max = <90>;
	vbat-max-gap = <30>;
	idvchg-term = <300>;
	/* ffc */
	pe5_therm_cur_thres = <500>;
	pe5_therm_vol_thres = <80>;
	pe5_therm_step = <3>;
	pe5_max_ibat = <6000>;
	tta-level-def = <0 0 0 0 25 40 50 60 70>;
	tta-curlmt = <0 0 0 0 0 300 600 900 (-1)>;
	tbat-level-def = <0 0 0 5 25 40 50 55 60>;
	tbat-curlmt = <(-1) (-1) (-1) 300 0 300 600 900 (-1)>;
	tdvchg-level-def = <0 0 0 5 25 55 70 85 90>; /* {0, 0, 0, 5, 25, 55, 60, 65, 70} */
	tdvchg-curlmt = <(-1) (-1) (-1) (-1) (-1) (-1) (-1) 900 (-1)>; /* {-1, -1, -1, 300, 0, 300, 600, 900, -1} */
	tswchg-level-def = <0 0 0 5 25 55 60 65 70>;
	tswchg-curlmt = <(-1) (-1) (-1) 200 0 200 300 400 (-1)>;
};
/* TN End modified by xinjun.lu/860715 20240905 CR/EKLAMU-202 */

&pdc {
	min_charger_voltage = <4600000>;
	pd_vbus_low_bound = <5000000>;
	pd_vbus_upper_bound = <9000000>;
	vsys_watt = <5000000>;
	ibus_err = <50>;

	/* single charger */
	sc_input_current = <3000000>;
	sc_charger_current = <3600000>;
};

&turbo_charger {
	compatible = "tinno,turbo_charger";
	status = "okay";
	gauge = <&mtk_gauge>;

	volt-steps = <20000>; /*uV*/
	curr-steps = <40000>; /*uA*/
	volt-max = <11000000>; /*uV*/
	curr-max = <3100000>; /*uA*/
	batt-curr-boost = <300000>; /*uA*/
	batt-ovp-limit = <4800000>; /*uV*/
	pl-chrg-vbatt-min = <3600000>; /*uV*/
	typec-middle-current = <1500000>; /*uA*/
	step-first-current-comp = <0>;
	temp-zones-num = <6>;
	turbo-chrg-temp-zones = <0  4208 1000 0    0    0    0   >,
				<10 4250 2900 4500 1750 0    0   >,
				<15 4500 2900 0    0    0    0   >,
				<35 4320 6000 4450 5200 4530 4000>,
				<45 4320 6000 4450 5200 4530 4000>,
				<60 4208 2900 0    0    0    0   >;
	thermal-min-level = <1000000>; /*uA*/
	sw-charging-curr-limited = <100000>; /*uA*/
	charging-curr-min = <1200000>; /*uA*/
	turbo-volt-comp = <300000>; /*uV*/
};

&pio {
	wt6670f_int_isp: wt6670t_int_isp {
		pin_cmd_dat {
			pinmux = <PINMUX_GPIO94__FUNC_GPIO94>;
			slew-rate = <0>;
			bias-pull-up = <1>;
			input-enable;
		};
	};

	wt6670f_default: wt6670t_default {
	};

	wt6670f_rst_normal: wt6670t_rst_normal {
		pin_cmd_dat {
			pinmux = <PINMUX_GPIO92__FUNC_GPIO92>;
			slew-rate = <1>;
			bias-disable;
			output-high;
		};
	};

	wt6670f_rst_isp: wt6670t_rst_isp {
		pin_cmd_dat {
			pinmux = <PINMUX_GPIO92__FUNC_GPIO92>;
			slew-rate = <1>;
			bias-disable;
			output-low;
		};
	};

	wt6670f_sda_normal: wt6670t_sda_normal {
		pin_cmd_dat {
			pinmux = <PINMUX_GPIO90__FUNC_SDA6>;
			slew-rate = <0>;
			bias-pull-up = <1>;
		};
	};

	wt6670f_sda_isp: wt6670t_sda_isp {
		pin_cmd_dat {
			pinmux = <PINMUX_GPIO90__FUNC_GPIO90>;
			slew-rate = <1>;
			output-low;
		};
	};

	wt6670f_scl_normal: wt6670t_scl_normal {
		pin_cmd_dat {
			pinmux = <PINMUX_GPIO89__FUNC_SCL6>;
			slew-rate = <0>;
			bias-pull-up = <1>;
		};
	};

	wt6670f_scl_isp: wt6670t_scl_isp {
		pin_cmd_dat {
			pinmux = <PINMUX_GPIO89__FUNC_GPIO89>;
			slew-rate = <1>;
			output-low;
		};
	};
};

&i2c7 {
	clock-frequency = <400000>;
	status = "ok";

	sgm4154x_chg: sgm41543@0B {
		status = "okay";
		compatible = "sgm,sgm41543D";
		reg = <0x0B>;

		io-channels = <&pmic_auxadc AUXADC_VCDT>;
		io-channel-names = "pmic_vbus";
		phys = <&u2port0 PHY_TYPE_USB2>;
		phy-names = "usb2-phy";

		sgm,irq-gpio = <&pio 3 IRQ_TYPE_EDGE_FALLING>;     //irq num base on hardware design
		sgm,chg-en-gpio = <&pio 150 0>;   //gpio num base on hardware design  1.MTK parent node name is pio  2.QUALCOMM parent node name is tlmm or other
	};

	cx2589x_chg: cx2589x@6A {
		status = "okay";
		compatible = "suncore,cx25890h";
		reg = <0x6A>;

		io-channels = <&pmic_auxadc AUXADC_VCDT>;
		io-channel-names = "pmic_vbus";
		phys = <&u2port0 PHY_TYPE_USB2>;
		phy-names = "usb2-phy";

		cx,irq-gpio = <&pio 3 IRQ_TYPE_EDGE_FALLING>;     //irq num base on hardware design
		cx,chg-en-gpio = <&pio 150 0>;   //gpio num base on hardware design  1.MTK parent node name is pio  2.QUALCOMM parent node name is tlmm or other
	};

	husb320@21 {
		status = "okay";
		compatible = "hynetek,husb320";
		reg = <0x21>;
		husb320,int-gpio = <&pio 4 1>;
		husb320,int-gpio_num = <4>;
		husb320,init-mode = <20>;                       /* try sink, DRP */
		husb320,host-current = <2>;                     /* 180uA host current */
		husb320,drp-toggle-time =  <1>;                 /* 70ms */
		husb320,drp-duty-time = <0>;                    /* 60 duty time */
		husb320,autosink-threshold = <1>;               /* 3P1V */
		husb320,cc-debounce-time = <3>;                 /* 150ms */
	};

	usb_type_c_aw35616@60 {
		status = "okay";
		compatible = "awinic,usb_type_c_aw35616";
		reg = <0x60>;
		aw35616,irq-gpio = <&pio 4 0x0>;
		aw35616-tcpc,name = "type_c_port0";
		aw35616-tcpc,role_def = <5>; /* 1: SNK Only, 2: SRC Only, 3: DRP, 4: Try.SRC, 5: Try.SNK */
		aw35616,rp_level = <0>; /* 0: Default, 1: 1.5, 2: 3.0 */
		aw35616-tcpc,notifier_supply_num = <3>; /* the number of notifier supply */
		aw35616_acc_support = <0>; /* 0:support, 1:No support */
		aw35616_toggle_cycle = <0>; /* 0:Disable, 1:40ms, 2:80ms, 3:160ms */
	};
};

&i2c6 {
	clock-frequency = <400000>;
	status = "ok";

	z350@35 {
		compatible = "injoinic,z350";
		reg = <0x35>;
		z350,reset_gpio = <&pio 92 IRQ_TYPE_EDGE_RISING>;
		z350,irq_gpio = <&pio 94 IRQ_TYPE_EDGE_FALLING>;
		z350,qc3-vset-mv = <9000>;
		interrupt-names = "z350_irq";
		status = "okay";
	};

	wt6670f@36 {
		compatible = "wt,wt6670f_charger";
		reg = <0x36>;
		status = "okay";

		phys = <&u2port0 PHY_TYPE_USB2>;
		phy-names = "usb2-phy";

		pinctrl-names = "default",  "rst_normal", "rst_isp", "scl_normal", "scl_isp", "sda_normal", "sda_isp";
		pinctrl-0 = <&wt6670f_default>;
		pinctrl-1 = <&wt6670f_rst_normal>;
		pinctrl-2 = <&wt6670f_rst_isp>;
		pinctrl-3 = <&wt6670f_scl_normal>;
		pinctrl-4 = <&wt6670f_scl_isp>;
		pinctrl-5 = <&wt6670f_sda_normal>;
		pinctrl-6 = <&wt6670f_sda_isp>;

		wt,wt6670f_scl_gpio = <&pio 89 0x01>;
		wt,wt6670f_sda_gpio = <&pio 90 0x01>;
		wt,wt6670f_int_gpio = <&pio 94 IRQ_TYPE_EDGE_RISING>;
		wt,wt6670f_rst_gpio = <&pio 92 IRQ_TYPE_EDGE_FALLING>;
	};

	sc2150-pd@4e{
		compatible = "southchip,sc2150";
		reg = <0x4E>;
		status = "okay";
		sc-tcpc,name = "type_c_port0"; /* tcpc_device's name */
		sc-tcpc,role_def = <5>; /* 0: Unknown, 1: SNK, 2: SRC */
					/* 3: DRP, 4: Try.SRC, 5: Try.SNK */
		sc-tcpc,rp_level = <0>; /* 0: Default, 1: 1.5, 2: 3.0 */
		sc-tcpc,vconn_supply  = <1>;  /* 0: Never, 1: Always, */
					      /* 2: EMarkOnly, 3: StartOnly */
		sc-tcpc,notifier_supply_num = <2>;
		sc2150,intr_gpio_num = <516>;
		pd-data {
			pd,vid = <0x311c>;
			pd,pid = <0x2150>;
			pd,source-cap-ext = /bits/ 8 <0x1c 0x31 0x00 0x66
						      0x00 0x00 0x00 0x00
						      0x00 0x00 0x00 0x00
						      0x00 0x00 0x00 0x00
						      0x00 0x00 0x00 0x00
						      0x00 0x00 0x01 0x02
						      0x00>;
			pd,sink-cap-ext = /bits/ 8 <0x1c 0x31 0x00 0x66
							   0x00 0x00 0x00 0x00
							   0x01 0x00 0x00 0x00
							   0x00 0x00 0x00 0x00
							   0x01 0x00 0x00 0x00
							   0x00 0x00 0x00 0x00>;
			pd,mfrs = "SouthChip";
			/*
			 *	VSAFE5V = 0, MAX_POWER = 1, CUSTOM = 2,
			 *	MAX_POWER_LV = 0x21, MAX_POWER_LVIC = 0x31
			 *	MAX_POWER_HV = 0x41, MAX_POWER_HVIC = 0x51
			 */
			pd,charging_policy= <0x31>;
			/*
			 * Fixed 5V, 500 mA <0x00019032>
			 * Fixed 5V, 1A <0x00019064>
			 * Fixed 5V, 2A <0x000190c8>
			 * Fixed 5V, 3A <0x0001912c>
			 * Fixed 9V, 500 mA <0x0002d032>
			 * Fixed 9V, 1A <0x0002d064>
			 * Fixed 9V, 2A <0x0002d0c8>
			 * Fixed 9V, 3A <0x0002d12c>
			 * Variable 5-9V, 1A <0x8642d064>
			 * Variable 5-9V, 2A <0x8642d0c8>
			 * Variable 5-9V, 3A <0x8642d12c>
			 * PPS 3V~5.9V, 3A <0xC0761E3C>
			 */
			pd,source-pdo-size = <1>;
			/* Fixed 5V,1.5A */
			pd,source-pdo-data = <0x00019096>;
			pd,sink-pdo-size = <1>;
			pd,sink-pdo-data = <0x000190c8>;
			/*0110 1110 0011 0010
			 * No DP, host + device
			 *	pd,id-vdo-size = <6>;
			 *	pd,id-vdo-data = <0xd14029cf 0x0 0x17110000
						  0x61000000 0x0 0x41000000>;
			 * With DP
			 *	pd,id-vdo-size = <6>;
			 *	pd,id-vdo-data = <0xd54029cf 0x0 0x17110000
						  0x61000000 0x0 0x41000000>;
			 */
			pd,id-vdo-size = <6>;
			pd,id-vdo-data = <0xd14029cf 0x0 0x17110000
						  0x61000000 0x0 0x41000000>;
			bat,nr = <1>;
			pd,country_nr = <0>;
			bat-info0 {
				bat,vid = <0x311c>;
				bat,pid = <0x2150>;
				bat,mfrs = "bat1";
				bat,design_cap = <3000>;
			};
		};
		dpm_caps {
			local_dr_power;
			local_dr_data;
			//local_ext_power;
			local_usb_comm;
			//local_usb_suspend;
			//local_high_cap;
			//local_give_back;
			local_no_suspend;
			local_vconn_supply;
			//attempt_discover_cable_dfp;
			//attempt_enter_dp_mode;
			attempt_discover_cable;
			attempt_discover_id;
			attempt_discover_svid;
			/* 0: disable, 1: prefer_snk, 2: prefer_src */
			pr_check = <0>;
			//pr_reject_as_source;
			//pr_reject_as_sink;
			//pr_check_gp_source;
			//pr_check_gp_sink;
			/* 0: disable, 1: prefer_ufp, 2: prefer_dfp */
			dr_check = <0>;
			//dr_reject_as_dfp;
			//dr_reject_as_ufp;
		};
		displayport {
			/* connection type = "both", "ufp_d", "dfp_d" */
			1st_connection = "dfp_d";
			2nd_connection = "dfp_d";
			signal,dp_v13;
			//signal,dp_gen2;
			//usbr20_not_used;
			typec,receptacle;
			ufp_d {
				//pin_assignment,mode_a;
				//pin_assignment,mode_b;
				//pin_assignment,mode_c;
				//pin_assignment,mode_d;
				//pin_assignment,mode_e;
			};
			dfp_d {
				//pin_assignment,mode_a;
				//pin_assignment,mode_b;
				pin_assignment,mode_c;
				pin_assignment,mode_d;
				pin_assignment,mode_e;
				//pin_assignment,mode_f;
			};
		};
	};

	cps8851_typec: cps8851@4a {
		compatible = "cps,cps8851";
		reg = <0x4a>;
		status = "okay";
		rt-tcpc,name = "type_c_port0"; /* tcpc_device's name */
		rt-tcpc,role_def = <5>; /* 0: Unknown, 1: SNK, 2: SRC */
					/* 3: DRP, 4: Try.SRC, 5: Try.SNK */
		rt-tcpc,rp_level = <0>; /* 0: Default, 1: 1.5, 2: 3.0 */
		rt-tcpc,vconn_supply = <3>;  /* 0: Never, 1: Always, */
						/* 2: EMarkOnly, 3: StartOnly */
		rt1711pd,intr_gpio = <&pio 4 0x0>;
		rt1711pd,intr_gpio_num = <4>;
		pd-data {
			pd,vid = <0x315c>;
			pd,pid = <0x8851>;
			pd,source-cap-ext = <0x8851315c 0x00000000 0x00000000
						0x00000000 0x00000000 0x06000000 0x00000000>;
			pd,sink-cap-ext = <0x8851315c  0x00000000 0x00010000
						0x00000000 0x05000000 0x0000000f>;
			pd,mfrs = "CPS_TCPC";

			/*
			*    VSAFE5V = 0, MAX_POWER = 1, CUSTOM = 2,
			*    MAX_POWER_LV = 0x21, MAX_POWER_LVIC = 0x31
			*    MAX_POWER_HV = 0x41, MAX_POWER_HVIC = 0x51
			*/
			pd,charging_policy= <0x31>;

			/*
			* Fixed 5V, 500 mA <0x00019032>
			* Fixed 5V, 1A <0x00019064>
			* Fixed 5V, 2A <0x000190c8>
			* Fixed 5V, 3A <0x0001912c>
			* Fixed 9V, 500 mA <0x0002d032>
			* Fixed 9V, 1A <0x0002d064>
			* Fixed 9V, 2A <0x0002d0c8>
			* Fixed 9V, 3A <0x0002d12c>
			* Variable 5-9V, 1A <0x8642d064>
			* Variable 5-9V, 2A <0x8642d0c8>
			* Variable 5-9V, 3A <0x8642d12c>
			* PPS 3V~5.9V, 3A <0xC0761E3C>
			*/
			pd,source-pdo-size = <1>;
			/* Fixed 5V,1.5A */
			pd,source-pdo-data = <0x00019096>;
			pd,sink-pdo-size = <1>;
			pd,sink-pdo-data = <0x000190c8>;

			/*
			* No DP, host + device
			*    pd,id-vdo-size = <3>;
			*    pd,id-vdo-data = <0xd10029cf 0x0 0x17110000>;
			* With DP
			*    pd,id-vdo-size = <3>;
			*    pd,id-vdo-data = <0xd60029cf 0x0 0x17110000
			*/

			pd,id-vdo-size = <6>;
			pd,id-vdo-data = <0xd140315c 0x0 0x88510000
								0x61000000 0x0 0x41000000>;

			bat,nr = <1>;
			pd,country_nr = <0>;

			bat-info0 {
				bat,vid = <0x315c>;
				bat,pid = <0x8851>;
				bat,mfrs = "bat1";
				bat,design_cap = <5000>;
			};

		//	bat-info1 {
			//	bat,vid = <0x8abc>;
			//	bat,pid = <0x5234>;
			//	bat,mfrs = "bat2";
			//	bat,design_cap = <4000>;
		//	};

		//	country0 {
			//	pd,country_code = <0x5457>;
			//	pd,country_len = <2>; /* max len = 26 */
			//	pd,country_data = <0xff 0xff>;
		//	};

		//	country1 {
			//	pd,country_code = <0x5553>;
			//	pd,country_len = <3>; /* max len = 26 */
			//	pd,country_data = <0xf1 0xf2 0xf3>;
		//	};
		};

		dpm_caps {
			local_dr_power;
			local_dr_data;
			//local_ext_power;
			local_usb_comm;
			//local_usb_suspend;
			//local_high_cap;
			//local_give_back;

			//local_no_suspend;
			//local_vconn_supply;


			//attemp_discover_cable_dfp;
			// attemp_enter_dp_mode;
			// attemp_discover_cable;
			// attemp_discover_id;

			/* 0: disable, 1: prefer_snk, 2: prefer_src */
			pr_check = <0>;

			//pr_reject_as_source;
			//pr_reject_as_sink;


			//pr_check_gp_source;
			//pr_check_gp_sink;

			/* 0: disable, 1: prefer_ufp, 2: prefer_dfp */
			dr_check = <0>;
			//dr_reject_as_dfp;
			//dr_reject_as_ufp;
		};
	};

	aw35615@22 {
		compatible = "awinic,aw35615";
		reg = <0x22>;
		awinic,int_n = <&pio 4 0x0>;
		aw35615,snk_pdo_size = <2>; /* set sink pdo num*/
		aw35615,snk_pdo_vol = <5000 9000>; /* set sink pdo voltage mV*/
		aw35615,snk_pdo_cur = <3000 2000>; /* set sink pdo current mA*/
		aw35615,src_pdo_size = <1>; /* set source pdo num*/
		aw35615,src_pdo_vol = <5000>; /* set source pdo voltage mV*/
		aw35615,src_pdo_cur = <2000>; /* set source pdo current mA*/
		aw35615,snk_tog_time = <0x38>; /* set toggle sink time */
		aw35615,src_tog_time = <0x24>; /* set toggle source time */
		status = "okay";
	};
};

&i2c5 {
	clock-frequency = <400000>;
	status = "ok";

	cps2011s@6E {
		status = "ok";
		compatible = "CPS,cps2011s";
		reg = <0x6E>;
		chg_name = "primary_dvchg";
		rm_name = "cps2011s";
		cps2011s,intr = <&pio 7 IRQ_TYPE_EDGE_RISING>;
	};

	sgm41600@6D {
		status = "okay";
		compatible = "sgm,sgm41600-standalone";
		reg = <0x6D>; // due to the same slave address as CPS2011S, set an fake slave address instead.
		sgm41600,intr_gpio = <&pio 7 IRQ_TYPE_EDGE_RISING>;
		//sgm41600,intr_gpio = <&gpio1 RK_PD1 IRQ_TYPE_EDGE_FALLING>;    /*GPIO1_D1*/
		charger_name = "primary_dvchg";
		charger_name_v4_19 = "primary_divider_chg";

		sgm,sgm41600,vbat-ovp-en = <1>;
		sgm,sgm41600,vbat-ovp = <24>;	//4V + BAT_OVP[5:0] × 25mV
		sgm,sgm41600,ibat-ocp-en = <0>;
		sgm,sgm41600,ibat-ocp  = <28>; //3A + IBAT_OCP[5:0] × 100mA
		sgm,sgm41600,vac-ovp-en = <1>;
		sgm,sgm41600,vac-ovp = <9>;//4V + AC_OVP[3:0] × 1V
		sgm,sgm41600,vbus-ovp-en = <1>;
		sgm,sgm41600,vbus-ovp = <75>; //4V + BUS_OVP[6:0] × 100mV
		sgm,sgm41600,ibus-ocp-en = <1>;
		sgm,sgm41600,ibus-ocp  = <7>; // 1.5A + IBUS_OCP[4:0] × 100mA; bypass mode:2.5A + IBUS_OCP[4:0] × 100mA
		sgm,sgm41600,vout-ovp-en = <1>;
		sgm,sgm41600,vout-ovp = <1>;	//4.6V + VOUT_OVP[1:0] × 200mV
		sgm,sgm41600,ibus-ucp-fall-en = <1>;
		sgm,sgm41600,ibus-ucp-fall  = <1>; /*0 = IBUS_UCP_R = 300mA rising, IBUS_UCP_F = 150mA falling；1 = IBUS_UCP_R = 500mA rising, IBUS_UCP_F = 250mA falling*/

		sgm,sgm41600,ibat-reg = <0>;/*0:200mA 1:300mA 2:400mA 3:500mA*/
		sgm,sgm41600,vbat-reg = <0>;/*0:50mV 1:100mV 2:150mV 3:200mV*/

		sgm,sgm41600,vbus-low-en = <1>;
		sgm,sgm41600,vbus-low = <0>;/*0:1.01 1:1.02 2:1.03 3:1.04*/
		sgm,sgm41600,vbus-high-en = <1>;
		sgm,sgm41600,vbus-high = <3>;/*0:1.10 1:1.15 2:1.20 3:1.25*/

		sgm,sgm41600,vdrop-ovp-en = <1>;
		sgm,sgm41600,vdrop-ovp-deg = <0>;/*0:10us 1:5ms*/
		sgm,sgm41600,vdrop-ovp = <5>;/*Range: 50mV (000) - 400mV (111)*/
		sgm,sgm41600,fsw-set = <3>;/*0:300kHz 1:375 2:500 3:600 4:750 5:833 6:1000 7:1250*/
		sgm,sgm41600,wdt-dis = <1>;
		sgm,sgm41600,wd-timeout = <3>; /*0:0.5s 1:1s 2:2s 3:5s 4:10s 5:20s 6:40s 7:80s*/
		sgm,sgm41600,ibat-sns-r = <1>; /*0:2mho 1:5mho*/
		sgm,sgm41600,mode = <0>; /*0:off 1:bypass 2: Forward Charge-pump mode */
	};
};
&{/} {
	charge_misc{
		compatible = "misc,charge";
		usb-overtemp-en-gpio = <&pio 159 0>;
	};
};
/*[TN.NJDC] charger overlay file.end*/
